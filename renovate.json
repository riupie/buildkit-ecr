{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "BuildKit version in workflow env and Dockerfile ARG",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^Dockerfile$/"],
      "matchStrings": ["BUILDKIT_VERSION[=:]\\s*(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "moby/buildkit",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ECR credential helper version in workflow env and Dockerfile ARG",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^Dockerfile$/"],
      "matchStrings": ["ECR_HELPER_VERSION[=:]\\s*(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "awslabs/amazon-ecr-credential-helper",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group upstream image dependency bumps into one PR",
      "matchManagers": ["custom.regex"],
      "groupName": "upstream dependencies"
    },
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
